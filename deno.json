{
  "lockfile": true,
  "nodeModulesDir": "auto",
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run tools/build.ts",
    "check": "deno run --allow-read tools/check.ts",
    "serve": "deno run --allow-read --allow-net tools/serve.ts",
    "preview": "deno task build && deno task serve"
  },
  "imports": {
    "preact": "npm:preact@^10.25",
    "preact-render-to-string": "npm:preact-render-to-string@^6.5",
    "htm": "npm:htm@^3.1",
    "linkedom": "npm:linkedom@^0.18"
  },
  "fmt": {
    "include": ["src/", "tools/"]
  },
  "lint": {
    "include": ["src/", "tools/"]
  }
}
